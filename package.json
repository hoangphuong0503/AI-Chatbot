{
  "name": "austra-chatbot-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "python scripts/prepare_knowledge.py",
    "ingest:check": "tsx scripts/ingest.ts --dry-run",
    "ingest": "tsx scripts/ingest.ts",
    "check:chat": "tsx scripts/check_chat.ts",
    "check:embeddings": "tsx scripts/check_embeddings.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "test:stream": "tsx scripts/test_stream.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "^0.0.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
