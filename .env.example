# Backend only. Copy to .env locally; never paste secrets into chat or frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Chat/rewrite use Intern AI. This key is never sent to Google/OpenAI.
CHAT_API_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-v4-flash-0731
# Dedicated local cross-encoder. Set llm to restore the DeepSeek reranker.
RERANKER_PROVIDER=local
# Leave blank to auto-detect .venv, then python3 (Mac/Linux) or python (Windows).
# Or set an absolute path to your own Python executable. Do not copy a Windows path to Mac.
RERANKER_PYTHON=
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LOCAL_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# auto: NVIDIA CUDA, then Apple MPS, otherwise CPU. Set cpu if MPS has problems.
LOCAL_RERANKER_DEVICE=auto
# Raw relevance logit, not a probability. Scores below this are excluded.
LOCAL_RERANKER_MIN_SCORE=-5
# Embeddings run locally through Ollama; chat stays on the DeepSeek API.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# Keep this key only if switching back to EMBEDDING_PROVIDER=gemini.
GEMINI_API_KEY=
# Count individual Gemini inputs, including inputs within a batch (live free-tier limit: 100/minute).
EMBEDDING_RPM=60
# Optional alternative: EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
PORT=3001
# preview: BM25 sources only. local-chat: BM25 + configured reranker + DeepSeek answers.
# cloud: BM25 + Supabase vector → RRF → configured reranker → answer; needs migrations + ingestion.
APP_MODE=preview
