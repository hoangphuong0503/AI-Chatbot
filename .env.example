# Backend only. Copy to .env locally; never paste secrets into chat or frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Chat and LLM reranker use Intern AI. This key is never sent to Google/OpenAI.
CHAT_API_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-v4-flash-0731
# Embeddings run locally through Ollama; chat stays on the DeepSeek API.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# Keep this key only if switching back to EMBEDDING_PROVIDER=gemini.
GEMINI_API_KEY=
# Count individual Gemini inputs, including inputs within a batch (live free-tier limit: 100/minute).
EMBEDDING_RPM=60
# Optional alternative: EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
PORT=3001
# preview: BM25 sources only. local-chat: BM25 + DeepSeek reranker/answers (only CHAT_API_KEY required).
# cloud: BM25 + Supabase vector → RRF → DeepSeek reranker → answer; needs migrations + ingestion.
APP_MODE=preview
